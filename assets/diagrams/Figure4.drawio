        <mxCell id="31" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Level 1 Top-Down Sum&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;P̃1 = P1 + BilinearUp_2×(P̃2)&amp;lt;br&amp;gt;Shape: 256 × H × W" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontStyle=1;align=center;fontColor=#581C87;">
          <mxGeometry x="525" y="110" width="230" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="32" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Channel Gate 1&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;GAP → Conv 1×1 → Sigmoid&amp;lt;br&amp;gt;Recalibration: P̃1 ⊙ g1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;align=center;fontColor=#78350F;">
