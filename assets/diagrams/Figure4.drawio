        <mxCell id="30" parent="1" vertex="1" value="3. Top-Down Fusion &amp;amp; Channel Gating" style="swimlane;startSize=26;horizontal=1;container=1;collapsible=0;rounded=1;arcSize=6;strokeWidth=1.5;fillColor=#F8FAFC;strokeColor=#475569;fontFamily=Helvetica;fontSize=11;fontStyle=1;align=center;fontColor=#0F172A;">
