        <mxCell id="34" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Channel Gate 2&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;GAP → Conv 1×1 → Sigmoid&amp;lt;br&amp;gt;Recalibration: P̃2 ⊙ g2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;align=center;fontColor=#78350F;">
