        <mxCell id="41" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Fusion 1 (Level 1)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Conv 3×3 (256 → 128) + GN(8) + GELU&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;G1&amp;lt;/b&amp;gt; (128 × H × W)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;align=center;fontColor=#14532D;">
          <mxGeometry x="810" y="130" width="220" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="42" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Fusion 2 (Level 2)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;BilinearUp_2× to H × W&amp;lt;br&amp;gt;Conv 3×3 (256 → 128) + GN(8) + GELU&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;G2&amp;lt;/b&amp;gt; (128 × H × W)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;align=center;fontColor=#14532D;">
          <mxGeometry x="810" y="290" width="220" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="43" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Fusion 3 (Level 3)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;BilinearUp_4× to H × W&amp;lt;br&amp;gt;Conv 3×3 (256 → 128) + GN(8) + GELU&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;G3&amp;lt;/b&amp;gt; (128 × H × W)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;align=center;fontColor=#14532D;">
          <mxGeometry x="810" y="450" width="220" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="50" parent="1" vertex="1" value="5. Fused Representation &amp;amp; Segmentation Head" style="swimlane;startSize=26;horizontal=1;container=1;collapsible=0;rounded=1;arcSize=6;strokeWidth=1.5;fillColor=#F8FAFC;strokeColor=#475569;fontFamily=Helvetica;fontSize=11;fontStyle=1;align=center;fontColor=#0F172A;">
          <mxGeometry x="1070" y="60" width="490" height="570" as="geometry"/>
        </mxCell>
        <mxCell id="51" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Multi-Scale Channel Concatenation&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;torch.cat([G1, G2, G3], dim=1)&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;F_seg&amp;lt;/b&amp;gt; (384 × H × W)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;fontStyle=1;align=center;fontColor=#115E59;">
          <mxGeometry x="1090" y="100" width="450" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="52" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Layer 0: ConvTransformerBlock&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;384 channels, 12 heads (head_dim=32), window=8&amp;lt;br&amp;gt;Captures long-range spatial plume dependencies" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;align=center;fontColor=#7C2D12;">
          <mxGeometry x="1090" y="175" width="450" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="53" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Layer 1: Grouped Convolution 3×3&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;in=384, out=384, groups=128 + GELU&amp;lt;br&amp;gt;Efficient local feature refinement" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;align=center;fontColor=#7C2D12;">
          <mxGeometry x="1090" y="250" width="450" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="54" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Layer 3: Progressive Channel Reduction 1&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Conv 1×1 (384 → 256)&amp;lt;br&amp;gt;Reduces feature dimensionality (-33%)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;align=center;fontColor=#7C2D12;">
          <mxGeometry x="1090" y="320" width="450" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="55" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Layer 4: Progressive Channel Reduction 2&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Conv 3×3 (256 → 128, padding=1)&amp;lt;br&amp;gt;Smoothing and intermediate spatial mixing (-50%)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;align=center;fontColor=#7C2D12;">
          <mxGeometry x="1090" y="390" width="450" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="56" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Layer 5 &amp;amp; 6: Final Projection &amp;amp; Activation&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Conv 1×1 (128 → 1) + Sigmoid()&amp;lt;br&amp;gt;Per-pixel probability estimation" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;align=center;fontColor=#7C2D12;">
          <mxGeometry x="1090" y="460" width="450" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="57" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Predicted Plume Probability Map (M̂)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Shape: (B, 1, H, W) ∈ [0, 1]&amp;lt;br&amp;gt;Thresholding at τ = 0.5 yields binary plume footprint" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;fontStyle=1;align=center;fontColor=#7F1D1D;">
