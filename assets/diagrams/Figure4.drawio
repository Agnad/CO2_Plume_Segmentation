        <mxCell id="21" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Lateral Conv 1&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Conv 1×1 (32 → 256)&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;P1&amp;lt;/b&amp;gt; (256 × H × W)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;align=center;fontColor=#4C1D95;">
