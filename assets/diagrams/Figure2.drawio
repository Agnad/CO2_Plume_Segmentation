        <mxCell id="60" parent="1" vertex="1" value="Physics-Constrained Joint Loss &amp;amp; Optimization" style="swimlane;startSize=30;horizontal=1;container=1;collapsible=0;rounded=1;arcSize=4;strokeWidth=1.5;dashed=1;dashPattern=6 4;fillColor=#FDF6F8;strokeColor=#C94C74;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=center;fontColor=#800F2F;">
          <mxGeometry x="1200" y="390" width="520" height="420" as="geometry"/>
