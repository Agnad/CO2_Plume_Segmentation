        <mxCell id="46" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Top-Down Fusion &amp;amp; Channel Gating&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;P̃&amp;lt;sub&amp;gt;2&amp;lt;/sub&amp;gt; = P&amp;lt;sub&amp;gt;2&amp;lt;/sub&amp;gt; + ↑&amp;lt;sub&amp;gt;2&amp;lt;/sub&amp;gt;(P&amp;lt;sub&amp;gt;3&amp;lt;/sub&amp;gt;)&amp;lt;br&amp;gt;P̃&amp;lt;sub&amp;gt;1&amp;lt;/sub&amp;gt; = P&amp;lt;sub&amp;gt;1&amp;lt;/sub&amp;gt; + ↑&amp;lt;sub&amp;gt;2&amp;lt;/sub&amp;gt;(P̃&amp;lt;sub&amp;gt;2&amp;lt;/sub&amp;gt;)&amp;lt;br&amp;gt;Gate: AdaptiveAvgPool → Conv 1×1 → Sigmoid&amp;lt;br&amp;gt;Recalibration: P̃&amp;lt;sub&amp;gt;i&amp;lt;/sub&amp;gt; ⊙ Gate(P̃&amp;lt;sub&amp;gt;i&amp;lt;/sub&amp;gt;)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#311B92;">
