        <mxCell id="61" parent="1" vertex="1" value="Joint Multi-Task Criterion: Total Loss = 0.3 L_den + 0.7 L_seg" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#1ABC9C;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fontColor=#117A65;">
          <mxGeometry x="1220" y="420" width="400" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="62" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Denoising Objective L&amp;lt;sub&amp;gt;den&amp;lt;/sub&amp;gt;&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;0.8 MSE + 0.2 (1-SSIM) + 0.05 TV + 0.1 L&amp;lt;sub&amp;gt;mass&amp;lt;/sub&amp;gt;&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;• Compares Denoised X̂ against Clean Target X&amp;lt;sup&amp;gt;clean&amp;lt;/sup&amp;gt;&amp;lt;br&amp;gt;• Mass conservation over plume region: 1/B ∑ |∑ M⊙X̂ - ∑ M⊙X&amp;lt;sup&amp;gt;clean&amp;lt;/sup&amp;gt;|" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#E74C3C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#78281F;">
          <mxGeometry x="1220" y="455" width="480" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="63" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Physics Coupling &amp;amp; Concentration Consistency (L&amp;lt;sub&amp;gt;phys&amp;lt;/sub&amp;gt;)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color='#935116'&amp;gt;Physical conversion:&amp;lt;/font&amp;gt; X&amp;lt;sub&amp;gt;phys&amp;lt;/sub&amp;gt; = 3.42 X̂ + 402.0 ppm&amp;lt;br&amp;gt;&amp;lt;font color='#935116'&amp;gt;Constraint:&amp;lt;/font&amp;gt; Plume mask M̂ &amp;gt; 0.5 must satisfy X&amp;lt;sub&amp;gt;phys&amp;lt;/sub&amp;gt; ≥ 402.0 ppm&amp;lt;br&amp;gt;&amp;lt;font color='#935116'&amp;gt;Violation Penalty:&amp;lt;/font&amp;gt; ReLU(402.0 - X&amp;lt;sub&amp;gt;phys&amp;lt;/sub&amp;gt; ⊙ M̂) clamped &amp;amp; log-scaled" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#F39C12;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#7D6608;">
          <mxGeometry x="1220" y="545" width="480" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="64" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Segmentation Objective L&amp;lt;sub&amp;gt;seg&amp;lt;/sub&amp;gt;&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;L&amp;lt;sub&amp;gt;FT&amp;lt;/sub&amp;gt; + 0.5 L&amp;lt;sub&amp;gt;phys&amp;lt;/sub&amp;gt; + 0.1 L&amp;lt;sub&amp;gt;TV-mask&amp;lt;/sub&amp;gt;&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;• Boundary-weighted Focal Tversky Loss (α=0.8, γ=2, band weight=3.0)&amp;lt;br&amp;gt;• Physics constraint L&amp;lt;sub&amp;gt;phys&amp;lt;/sub&amp;gt; couples Denoised X̂ with Plume Mask M̂&amp;lt;br&amp;gt;• Mask total variation regularization L&amp;lt;sub&amp;gt;TV-mask&amp;lt;/sub&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#E74C3C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#78281F;">
          <mxGeometry x="1220" y="640" width="480" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="65" parent="1" vertex="1" value="&amp;lt;b&amp;gt;Total Joint Loss &amp;amp; Optimization&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font size='3'&amp;gt;&amp;lt;b&amp;gt;L&amp;lt;sub&amp;gt;total&amp;lt;/sub&amp;gt; = 0.3 L&amp;lt;sub&amp;gt;den&amp;lt;/sub&amp;gt; + 0.7 L&amp;lt;sub&amp;gt;seg&amp;lt;/sub&amp;gt;&amp;lt;/b&amp;gt;&amp;lt;/font&amp;gt;&amp;lt;br&amp;gt;Gradient updates: \theta_{seg} (Trainable) &amp;amp;amp; \theta_{den}^{adapt} (Norm/Bias) | \theta_{den}^{frozen} Frozen (∇=0)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5D8DC;strokeColor=#34495E;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#17202A;">
